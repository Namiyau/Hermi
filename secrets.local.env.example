# Copy this file to secrets.local.env and fill local values.
# Never commit secrets.local.env.
HERMI_OWNER_TOKEN=replace-with-a-local-owner-token
HERMI_CHANNEL_TOKEN=replace-with-a-local-channel-token
HERMI_HERMES_API_URL=http://127.0.0.1:8642/v1/chat/completions
HERMI_PROFILE_API_URLS=trainee=http://127.0.0.1:8642/v1/chat/completions,imouto=http://127.0.0.1:8643/v1/chat/completions,maid=http://127.0.0.1:8644/v1/chat/completions
HERMI_HERMES_API_KEY=replace-with-local-hermes-key
HERMI_PORT=8789
HERMI_QLOS_BASE_URL=http://127.0.0.1:8766
HERMI_QLOS_SEND_TOKEN=replace-with-local-qlos-token
HERMI_DB_PATH=./state/hermi_gateway.db
HERMI_MEDIA_DIR=./state/media
